<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ywjs.jcsy.mapper.MindMapMapper">

    <select id="getMindMapByDimension" resultMap="mindMapByDimension">
        select d.dimension_name, group_concat(p.project_id) project_ids from dimension d
        inner join project_dimension_relation pd on d.dimension_id=pd.dimension_id
        inner join project p on p.project_id = pd.project_id
        group by d.dimension_id
    </select>
    <resultMap id="mindMapByDimension" type="com.ywjs.jcsy.vo.MindMapByDimensionVo">

    </resultMap>

